# Copy to .env.docker (Docker) or .env (local) and fill in the secrets.

# APP
APP_NAME=GraphRAG
APP_ENV=production
DEBUG=False

# POSTGRES (Docker service name "postgres"; use 127.0.0.1 locally)
POSTGRES_USER=graphuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=graphrag
# URL-encode special characters in the password (e.g. & -> %26)
POSTGRES_URL=postgresql://graphuser:change-me@postgres:5432/graphrag

# QDRANT
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ksl_chunks

# NEO4J
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# GOOGLE DRIVE (only needed for POST /api/v1/ingest)
GOOGLE_CREDENTIALS_PATH=/app/credentials/service_account.json
GOOGLE_DRIVE_FOLDER_ID=

# OPENROUTER
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIM=2048

# GRAPH EXTRACTION (one LLM call per GRAPH_BATCH_CHARS of text)
GRAPH_EXTRACTION_ENABLED=True
GRAPH_BATCH_CHARS=24000
GRAPH_MAX_WORKERS=2
